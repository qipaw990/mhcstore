# ========================================================
# Dockerfile Ringan untuk Deploy Flutter Web Statis
# Ukuran image ~25MB, waktu build < 1 detik.
# Syarat: jalankan `flutter build web --release` terlebih dahulu di host/lokal.
# ========================================================
FROM nginx:alpine

LABEL maintainer="CicalengkaGO"
LABEL description="CicalengkaGO Flutter Web Static Serving"

# Bersihkan direktori default nginx
RUN rm -rf /usr/share/nginx/html/*

# Salin konfigurasi Nginx SPA
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Salin hasil build Flutter web statis
COPY build/web /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
