{
  "manifest_version": 3,
  "name": "CicalengkaGO - GrabFood Store & Menu Scraper",
  "version": "1.0.0",
  "description": "Ekstensi Chrome untuk meng-scrape toko dan menu dari GrabFood & mengimpornya langsung ke CicalengkaGO.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://*/*",
    "https://food.grab.com/*",
    "https://cicago.store/*",
    "http://cicago.store/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CicalengkaGO Scraper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://food.grab.com/*"],
      "js": ["content.js"]
    }
  ]
}
